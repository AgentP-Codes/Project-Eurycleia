# Settings for setup.sh. Copy this file to settings.env and fill it in. NOTHING SECRET goes here: setup.sh asks
# for each password or token and puts it straight into Key Vault.

RESOURCE_GROUP=eurycleia-live          # the resource group your Foundry resource is in
LOCATION=australiaeast
AI_RESOURCE=eurycleia-ai               # the Foundry / Azure OpenAI resource name
MODEL_DEPLOYMENT=gpt-5-mini            # the model deployment's name
TEST_INBOX=your.test.inbox@gmail.com   # the test Gmail address (no "+")
SLACK_SUPPORT_CHANNEL=C0XXXXXXXXX      # Slack channel ids (they start with C)
SLACK_REPORT_CHANNEL=C0XXXXXXXXX
IMAGE=ghcr.io/agentp-codes/eurycleia-live:latest   # built by GitHub from the repository
IMAGE_TOKEN_USER=AgentP-Codes          # only for a PRIVATE repository's image: the GitHub user the token belongs
                                       # to. setup.sh asks for the token (read:packages only). Leave empty if public.
BUDGET_AUD_PER_DAY=2                   # the agent stops for the day once its model spending reaches this
