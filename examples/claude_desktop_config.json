{
  "mcpServers": {
    "acme-support": {
      "command": "eurycleia",
      "args": [
        "serve",
        "--policy", "/path/to/eurycleia.yaml",
        "--task", "support_reply",
        "--trusted", "customer_id=12",
        "--audit", "/path/to/audit.jsonl",
        "--key", "/path/to/customer.key",
        "--",
        "python", "/path/to/your_crm_mcp_server.py"
      ]
    }
  }
}
